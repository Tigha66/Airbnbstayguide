# Public canonical URL of the app (used for links, QR codes, OG tags, auth callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Neon Postgres (free tier: https://console.neon.tech) -------------------
# Pooled connection string. Without it the app runs in browser-only demo mode.
DATABASE_URL=

# --- Auth.js login providers -----------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# Authorized redirect URI: <NEXT_PUBLIC_APP_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Apple Developer → Sign in with Apple. Redirect URI: <NEXT_PUBLIC_APP_URL>/api/auth/callback/apple
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=
# Email/password sign-in needs DATABASE_URL and AUTH_SECRET.
# Forgot password and email verification require Resend.
RESEND_API_KEY=
EMAIL_FROM="StayGuide <hello@getstayguide.com>"

# --- AI (server-side only) -------------------------------------------------
# Hugging Face (free): https://huggingface.co/settings/tokens (enable "Inference Providers")
HF_TOKEN=
# Optional: "huggingface" (default when HF_TOKEN set) | "openai-compatible" | "openai" | "anthropic"
AI_PROVIDER=
# Optional model id; defaults to a free Hugging Face instruct model
AI_MODEL=
# Only for AI_PROVIDER=openai-compatible (e.g. Groq)
AI_BASE_URL=
AI_API_KEY=
# Only for AI_PROVIDER=openai / anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Stripe ----------------------------------------------------------------
# Secret key (sk_test_... while testing, sk_live_... in production). Never expose it to the browser.
STRIPE_SECRET_KEY=
# Signing secret of the /api/stripe/webhook endpoint. `pnpm --filter @stayguide/web stripe:setup`
# (with APP_URL set to the public URL) creates the products, prices, portal config and webhook
# and prints this value. Connect (Express) must be activated in the Stripe dashboard for payouts.
STRIPE_WEBHOOK_SECRET=

# --- Seed script ------------------------------------------------------------
# `pnpm --filter @stayguide/web db:seed` uses DATABASE_URL (+ HF_TOKEN for the AI builder)
# to create the live demo guide /g/sea-breeze-loft owned by demo@stayguide.app.

# Reviewed Stripe catalogue and portal. Customer requests never create prices.
STRIPE_PRICE_STARTER_MONTH=
STRIPE_PRICE_STARTER_YEAR=
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
STRIPE_PORTAL_CONFIGURATION_ID=

# Explicit migration invocation only. Do not keep these flags enabled at runtime.
STAYGUIDE_ALLOW_MIGRATIONS=false
STAYGUIDE_RECOVERY_POINT=

# Optional complimentary Manager feature access for verified account emails.
# Server-only; does not change Stripe subscriptions, plans or AI/property quotas.
# Leave empty to require a paid Manager plan. Revoke by removing an email and redeploying.
MANAGER_ACCESS_EMAILS=

# --- GuestPulse scheduled delivery (off until provider acceptance) -----------
# At least 32 random characters; Vercel sends this as the Bearer token to cron.
CRON_SECRET=
STAYGUIDE_PMS_DELIVERY_ENABLED=false
# Five-minute Vercel Cron cadence requires Pro/Enterprise hosting.
# Keep billing closed until production acceptance has passed.
STAYGUIDE_MANAGER_CHECKOUT_ENABLED=false
STRIPE_PRICE_MANAGER_MONTH=
STRIPE_PRICE_MANAGER_YEAR=
# Expected account for the read-only billing verifier (never a browser variable).
STRIPE_EXPECTED_ACCOUNT_ID=
