{
  "name": "@stayguide/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/build-sw.mjs && next dev --hostname 0.0.0.0",
    "build": "node scripts/migrate.mjs && node scripts/build-sw.mjs && next build",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "tsx scripts/seed.mts",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.58",
    "@ai-sdk/openai": "^3.0.41",
    "@neondatabase/serverless": "^1.2.0",
    "@stayguide/shared": "workspace:*",
    "@vercel/analytics": "^1.6.1",
    "ai": "^6.0.116",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next": "16.3.8",
    "next-auth": "5.0.0-beta.32",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "serwist": "^9.5.13",
    "stripe": "^20.4.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^22.19.15",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
