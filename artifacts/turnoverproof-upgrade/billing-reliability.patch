+// Run with: node --test scripts/test-billing-regressions.cjs
+// Exercises the real TypeScript service with isolated Stripe/Supabase adapters.
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const ts = require('typescript');
+
+function harness(options = {}) {
+  const state = {
+    receipts: new Set(), updates: [], failUpdate: false, failLookup: false,
+    failReceiptRead: false, failReceiptWrite: false, missingOrg: false,
+    failRetrieve: false, duplicateReceipt: false, calls: 0,
+    ...options,
+  };
+  const error = (message, code = '08006') => ({ message, code });
+  const db = { from(table) {
+    let action = 'read'; let value; let id;
+    const q = {
+      select() { return q; },
+      eq(key, val) { if (key === 'id') id = val; return q; },
+      update(val) { action = 'update'; value = val; return q; },
+      async insert(val) {
+        if (state.failReceiptWrite) return { error: error('receipt write failed') };
+        if (state.duplicateReceipt || state.receipts.has(val.id)) return { error: error('duplicate', '23505') };
+        state.receipts.add(val.id); return { error: null };
+      },
+      async maybeSingle() {
+        if (table === 'stripe_events') {
+          if (state.failReceiptRead) return { error: error('receipt read failed') };
+          return { data: state.receipts.has(id) ? { id } : null, error: null };
+        }
+        if (action === 'update') {
+          if (state.failUpdate) return { data: null, error: error('organization write failed') };
+          if (state.missingOrg) return { data: null, error: null };
+          state.updates.push(value); return { data: { id: id || 'org_1' }, error: null };
+        }
+        if (state.failLookup) return { error: error('lookup failed') };
+        return { data: state.missingOrg ? null : { id: 'org_1' }, error: null };
+      },
+      then(resolve, reject) { return q.maybeSingle().then(resolve, reject); },
+    };
+    return q;
+  } };
+  const sub = {
+    id: 'sub_1', customer: 'cus_1', status: 'active', metadata: { organization_id: 'org_1' },
+    items: { data: [{ price: { id: 'price_1' } }] },
+  };
+  const stripe = {
+    subscriptions: { async retrieve() { state.calls++; if (state.failRetrieve) throw new Error('Stripe unavailable'); return sub; } },
+    customers: { async create() { return { id: 'cus_new' }; } },
+    checkout: { sessions: { async create() { return { url: 'https://checkout.example/session' }; } } },
+  };
+  const plan = { stripeEnvKey: 'STRIPE_PRICE_TURNOVERPROOF', id: 'turnoverproof', includedSeats: 10 };
+  const serverEnv = { STRIPE_SECRET_KEY: state.noStripe ? undefined : 'test-only', STRIPE_PRICE_TURNOVERPROOF: 'price_1' };
+  const mocks = {
+    'server-only': {}, stripe: class { constructor() { return stripe; } },
+    '@/lib/db/service': { serviceClient: () => db },
+    '@/lib/env': { serverEnv, clientEnv: { NEXT_PUBLIC_APP_URL: 'https://app.example' } },
+    '@/lib/plans': { PLANS: { turnoverproof: plan }, getPlan: () => plan },
+  };
+  const filename = path.join(__dirname, '../src/lib/services/billing.ts');
+  const source = fs.readFileSync(filename, 'utf8');
+  const compiled = ts.transpileModule(source, {
+    compilerOptions: { module: ts.ModuleKind.CommonJS, target: ts.ScriptTarget.ES2022, esModuleInterop: true },
+  }).outputText;
+  const mod = { exports: {} };
+  new Function('require', 'module', 'exports', compiled)(name => {
+    if (!(name in mocks)) throw new Error(`Unexpected import: ${name}`);
+    return mocks[name];
+  }, mod, mod.exports);
+  const checkout = { id: 'evt_checkout', type: 'checkout.session.completed', data: { object: { subscription: 'sub_1', metadata: {} } } };
+  const event = { id: 'evt_subscription', type: 'customer.subscription.updated', data: { object: sub } };
+  return { ...mod.exports, state, event, checkout, sub };
+}
+
+test('successful event updates entitlement then records receipt; repeat is a no-op', async () => {
+  const h = harness(); await h.processStripeEvent(h.event); await h.processStripeEvent(h.event);
+  assert.equal(h.state.updates.length, 1); assert.ok(h.state.receipts.has(h.event.id));
+  assert.equal(h.state.updates[0].subscription_status, 'active');
+});
+test('failed Stripe retrieval remains retryable', async () => {
+  const h = harness({ failRetrieve: true });
+  await assert.rejects(h.processStripeEvent(h.checkout), /Stripe unavailable/);
+  assert.equal(h.state.receipts.size, 0); h.state.failRetrieve = false;
+  await h.processStripeEvent(h.checkout); assert.equal(h.state.updates.length, 1);
+});
+test('failed organization update remains retryable', async () => {
+  const h = harness({ failUpdate: true });
+  await assert.rejects(h.processStripeEvent(h.event), /organization write failed/);
+  assert.equal(h.state.receipts.size, 0); h.state.failUpdate = false;
+  await h.processStripeEvent(h.event); assert.equal(h.state.updates.length, 1);
+});
+test('receipt read errors are surfaced instead of acknowledged', async () => {
+  const h = harness({ failReceiptRead: true });
+  await assert.rejects(h.processStripeEvent(h.event), /receipt read failed/);
+  assert.equal(h.state.updates.length, 0);
+});
+test('receipt write errors trigger a safe replay of the state update', async () => {
+  const h = harness({ failReceiptWrite: true });
+  await assert.rejects(h.processStripeEvent(h.event), /receipt write failed/);
+  h.state.failReceiptWrite = false; await h.processStripeEvent(h.event);
+  assert.equal(h.state.updates.length, 2); assert.ok(h.state.receipts.has(h.event.id));
+});
+test('duplicate receipt after successful processing is accepted', async () => {
+  const h = harness({ duplicateReceipt: true }); await h.processStripeEvent(h.event);
+  assert.equal(h.state.updates.length, 1);
+});
+test('missing Stripe configuration is not recorded as successful checkout fulfillment', async () => {
+  const h = harness({ noStripe: true });
+  await assert.rejects(h.processStripeEvent(h.checkout), /Billing is not configured/);
+  assert.equal(h.state.receipts.size, 0);
+});
+test('missing organization does not silently consume the event', async () => {
+  const h = harness({ missingOrg: true });
+  await assert.rejects(h.processStripeEvent(h.event), /organization not found/);
+  assert.equal(h.state.receipts.size, 0);
+});
+test('lookup errors do not silently consume the event', async () => {
+  const h = harness({ failLookup: true }); h.sub.metadata = {};
+  await assert.rejects(h.processStripeEvent(h.event), /lookup failed/);
+  assert.equal(h.state.receipts.size, 0);
+});
+test('unknown customer mapping remains retryable', async () => {
+  const h = harness({ missingOrg: true }); h.sub.metadata = {};
+  await assert.rejects(h.processStripeEvent(h.event), /no matching billing organization/);
+  assert.equal(h.state.receipts.size, 0);
+});
+test('expanded checkout subscription objects are supported', async () => {
+  const h = harness(); h.checkout.data.object.subscription = { id: 'sub_1' };
+  await h.processStripeEvent(h.checkout); assert.equal(h.state.calls, 1);
+  assert.ok(h.state.receipts.has(h.checkout.id));
+});
+test('failed checkout customer persistence stops checkout creation', async () => {
+  const h = harness({ failUpdate: true });
+  await assert.rejects(h.createCheckoutSession({ id: 'org_1', name: 'Demo' }, 'turnoverproof'), /Could not save billing customer/);
+});
