# Public canonical URL of the app (used for links, QR codes, OG tags, auth callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Neon Postgres (free tier: https://console.neon.tech) -------------------
# Pooled connection string. Without it the app runs in browser-only demo mode.
DATABASE_URL=

# --- Auth.js with Google login ---------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# Authorized redirect URI: <NEXT_PUBLIC_APP_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- AI (server-side only) -------------------------------------------------
# Hugging Face (free): https://huggingface.co/settings/tokens (enable "Inference Providers")
HF_TOKEN=
# Optional: "huggingface" (default when HF_TOKEN set) | "openai-compatible" | "openai" | "anthropic"
AI_PROVIDER=
# Optional model id; defaults to a free Hugging Face instruct model
AI_MODEL=
# Only for AI_PROVIDER=openai-compatible (e.g. Groq)
AI_BASE_URL=
AI_API_KEY=
# Only for AI_PROVIDER=openai / anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Stripe ----------------------------------------------------------------
# Secret key (sk_test_... while testing, sk_live_... in production). Never expose it to the browser.
STRIPE_SECRET_KEY=
# Signing secret of the /api/stripe/webhook endpoint. `pnpm --filter @stayguide/web stripe:setup`
# (with APP_URL set to the public URL) creates the products, prices, portal config and webhook
# and prints this value. Connect (Express) must be activated in the Stripe dashboard for payouts.
STRIPE_WEBHOOK_SECRET=

# --- Email notifications ----------------------------------------------------
# Resend API key + verified sender for host inbox/extras notifications.
RESEND_API_KEY=
EMAIL_FROM="StayGuide <hello@example.com>"

# --- Monitoring -------------------------------------------------------------
# Optional generic JSON webhook used by the built-in monitoring helper.
STAYGUIDE_MONITORING_WEBHOOK=
# Optional provider DSNs/tokens for deployment dashboards; status reports these as monitoring configured.
SENTRY_DSN=
LOGTAIL_SOURCE_TOKEN=

# --- Seed script ------------------------------------------------------------
# `pnpm --filter @stayguide/web db:seed` uses DATABASE_URL (+ HF_TOKEN for the AI builder)
# to create the live demo guide /g/sea-breeze-loft owned by demo@stayguide.app.
